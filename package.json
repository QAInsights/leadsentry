{
  "name": "leadsentry",
  "version": "0.1.0",
  "description": "Childhood lead-exposure risk triage agent for the Mireye Build Challenge",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "_engines_note": "Locked to Node 22+ because all @ai-sdk/* and ai packages require >=22 in package-lock.json.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts --demo",
    "validate:erie": "tsx src/index.ts --validate-zip-list data/erie-zips.json",
    "validate:demo": "tsx src/index.ts --validate-zip-list data/erie-zips-demo.json --demo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/deepseek": "^3.0.24",
    "@ai-sdk/google": "^4.0.36",
    "@ai-sdk/mcp": "^2.0.27",
    "@ai-sdk/openai": "^4.0.33",
    "@ai-sdk/openai-compatible": "^3.0.25",
    "ai": "^7.0.55",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
