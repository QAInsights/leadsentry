# Mireye API token — sign up at https://www.mireye.com/account
# Free tiers with hackathon codes: GROWTH (growth tier) or BUILD (build tier), one month free.
MIREYE_API_TOKEN=

# US Census Bureau API key — free, instant: https://api.census.gov/data/key_signup.html
# Required as of 2025; keyless requests now 302 to missing_key.html.
CENSUS_API_KEY=

# Vendor-agnostic model selection: provider:model
# Examples:
#   LLM_MODEL=openai:gpt-4o
#   LLM_MODEL=anthropic:claude-sonnet-4-5
#   LLM_MODEL=google:gemini-2.5-flash
#   LLM_MODEL=deepseek:deepseek-chat        (cheap; or deepseek:deepseek-reasoner)
#   LLM_MODEL=meta:muse-spark-1.2           (Meta Model API, api.meta.ai)
#   LLM_MODEL=openai-compatible:llama3.1   (with LLM_BASE_URL=http://localhost:11434/v1)
LLM_MODEL=openai:gpt-4o

# Only needed for openai-compatible (e.g. Ollama, LM Studio, vLLM)
LLM_BASE_URL=

# Provider API keys — set the one(s) matching LLM_MODEL
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
MODEL_API_KEY=
